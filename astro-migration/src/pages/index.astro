---
/* Static page, no frontmatter logic needed */
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>The Spanish Nerd | A System for Disciplined Mastery</title>
    <meta
      name="description"
      content="The Spanish Nerd is a high-efficiency Hybrid Workbook System for disciplined learners."
    />

    <link rel="canonical" href="https://thespanishnerd.com" />

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,400;0,600;1,400&family=Inter:wght@300;400;600&display=swap"
      rel="stylesheet"
    />

    <style>
      :root {
        --color-paper: #f9f7f2;
        --color-ink: #1a1a1a;
        --color-accent: #8b6e37;
        --color-muted: #555555;
      }

      body {
        background-color: var(--color-paper);
        color: var(--color-ink);
        font-family: "Inter", sans-serif;
      }

      h1,
      h2,
      h3,
      .serif {
        font-family: "Crimson Pro", serif;
      }

      .btn-primary {
        background-color: var(--color-ink);
        color: white;
        padding: 1rem 2rem;
        border: 1px solid var(--color-ink);
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-weight: 600;
        font-size: 0.875rem;
        display: inline-block;
        cursor: pointer;
      }

      .btn-primary:hover {
        background-color: transparent;
        color: var(--color-ink);
      }
    </style>
  </head>

  <body>
    <nav class="sticky top-0 z-50 bg-[#F9F7F2]/90 border-b border-neutral-200">
      <div class="flex justify-between items-center px-8 py-6 max-w-7xl mx-auto">
        <div class="text-xl font-bold serif italic">The Spanish Nerd.</div>
        <div class="hidden md:flex gap-8 text-xs uppercase tracking-widest font-semibold">
          <a href="/method">The Method</a>
          <a href="#pricing">Invest</a>
        </div>
      </div>
    </nav>

    <main>
      <section class="max-w-7xl mx-auto grid md:grid-cols-2 gap-16 items-center pt-12 px-6">
        <div>
          <h1 class="text-5xl md:text-7xl leading-tight mb-6 serif">
            Serious progress<br />
            <span class="italic text-neutral-500">rather than</span><br />
            silly fluff.
          </h1>
          <p class="text-lg text-neutral-600 max-w-md mb-8">
            A high-efficiency Hybrid Workbook System for disciplined learners.
          </p>
          <a
            href="https://payhip.com/b/Ke8bv"
            class="btn-primary"
          >
            Buy Now
          </a>
        </div>

        <div>
          <img
            src="/spanish-nerd-bundle.png"
            alt="The Spanish Nerd System"
            class="w-full max-w-lg mx-auto"
          />
        </div>
      </section>

      <section id="pricing" class="bg-zinc-50 border-t border-neutral-200 mt-24 px-6 py-24">
        <div class="max-w-4xl mx-auto text-center">
          <h2 class="text-5xl serif italic mb-4">Invest in yourself.</h2>
          <p class="text-neutral-600">
            This system is for those who refuse to waste their time.
          </p>
        </div>
      </section>
    </main>

    <footer class="bg-zinc-900 text-white py-16 px-8 mt-24">
      <div class="max-w-7xl mx-auto text-center text-sm text-neutral-400">
        © 2026 The Spanish Nerd. All Rights Reserved.
      </div>
    </footer>
  </body>
</html>
